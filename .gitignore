# Python environments, caches, and package outputs
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
*.egg-info/
backend/build/
backend/dist/
.venv/
venv/

# Private environment and machine-specific settings
.env
.env.*
!.env.example
.aws/
.codex/
backend/data/
backend/config/*.json
/config/*.json

# Runtime data; keep only directory placeholders
/data/*
!/data/captures/
!/data/calibration/
!/data/analysis/
!/data/database/
!/data/logs/
!/data/snapshots/
!/data/temp/
data/captures/*
data/calibration/*
data/analysis/*
data/database/*
data/logs/*
data/snapshots/*
data/temp/*
!data/captures/.gitkeep
!data/calibration/.gitkeep
!data/analysis/.gitkeep
!data/database/.gitkeep
!data/logs/.gitkeep
!data/snapshots/.gitkeep
!data/temp/.gitkeep

# Frontend dependencies, builds (including isolated test builds), and coverage
node_modules/
frontend/.next*/
frontend/out/
frontend/coverage/
frontend/.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and operating-system temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
