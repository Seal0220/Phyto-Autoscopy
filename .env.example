# Shared private runtime values. FastAPI and the Next.js server load this file
# independently; start.bat only verifies it before launching either process.
# Never commit the matching .env file or use NEXT_PUBLIC_ for these values.
PHYTO_AUTOSCOPY_OPERATOR_PASSWORD=choose-a-strong-local-password
PHYTO_AUTOSCOPY_BFF_TOKEN=replace-with-a-long-random-token
PHYTO_AUTOSCOPY_SESSION_SECRET=replace-with-a-long-random-token

# Backend paths are resolved from backend/ when started through start.bat.
# Use `start.bat --mock` to enable mock cameras and motor.
PHYTO_AUTOSCOPY_CONFIG_DIR=config
PHYTO_AUTOSCOPY_AUDIT_LOG=data/logs/audit.jsonl
